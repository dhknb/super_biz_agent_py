# SuperBizAgent 环境变量示例
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，请勿提交真实密钥

# ============================================================
# 应用配置
# ============================================================
APP_NAME=SuperBizAgent
APP_VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=9900

# 允许的 CORS 来源，逗号分隔；生产环境请改为具体域名
# 示例：CORS_ORIGINS=https://example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:9900,http://127.0.0.1:9900

# ============================================================
# DashScope（阿里云通义千问）
# ============================================================
# 申请地址：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# ============================================================
# Milvus 向量数据库
# ============================================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# ============================================================
# RAG 检索配置
# ============================================================
RAG_TOP_K=3
RAG_MODEL=qwen-max

# ============================================================
# 文档分块配置
# ============================================================
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# ============================================================
# MCP 服务配置
# transport 支持：stdio（本地进程）、streamable-http（HTTP 流）
# ============================================================
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp
